# Valeurs publiques uniquement dans le navigateur : URL du projet et clé anon/publishable.
# Le serveur local lit aussi ces deux variables pour /api/public-config et vérifie les JWT Supabase.
# Ne jamais mettre la clé service_role ici ni dans le front-end.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<clé-publique-anon-ou-publishable>

# Versions de formation pouvant recevoir une demande de paiement.
COURSE_VERSIONS=formation-fiscale-v1
